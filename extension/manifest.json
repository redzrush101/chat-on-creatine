{
  "manifest_version": 3,
  "name": "Chat on Creatine Bridge",
  "version": "0.1.1",
  "description": "Lets Chat on Creatine drive ChatGPT in this browser.",
  "minimum_chrome_version": "125",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-tap.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-driver.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat on Creatine Bridge",
    "default_icon": {
      "128": "icons/icon.png"
    }
  }
}
