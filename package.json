{
  "name": "chat-on-creatine",
  "version": "0.6.0",
  "private": true,
  "description": "Desktop and terminal coding workspace that drives ChatGPT and serves local tools over MCP.",
  "author": "redzrush101 <109347215+redzrush101@users.noreply.github.com>",
  "homepage": "https://github.com/redzrush101/chat-on-creatine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redzrush101/chat-on-creatine.git"
  },
  "bugs": {
    "url": "https://github.com/redzrush101/chat-on-creatine/issues"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/theme.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "npm run build && vitest run --config vitest.live.config.ts",
    "check": "node scripts/check-repo.mjs && node scripts/theme.mjs --check",
    "verify": "npm run check && npm run typecheck && npm run test && npm run build",
    "tunnel-client": "node scripts/fetch-tunnel-client.mjs",
    "rebuild-native": "node scripts/rebuild-native.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "smoke": "node scripts/smoke-packaged.mjs release",
    "prepare": "node scripts/install-hooks.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "cli": "node scripts/creatine.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "node-pty": "1.1.0",
    "quickjs-emscripten-core": "^0.32.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "1.2.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "gifenc": "^1.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.545.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "bin": {
    "creatine": "scripts/creatine.mjs"
  }
}
